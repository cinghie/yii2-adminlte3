<?xml version="1.0"?>
<ruleset name="yii2-adminlte3">
    <description>PSR-12 coding standards for the yii2-adminlte3 public package.</description>

    <file>AdminLTEAsset.php</file>
    <file>AdminLTEMinifyAsset.php</file>
    <file>AdminLTECoreAsset.php</file>
    <file>AdminLTECoreMinifyAsset.php</file>
    <file>AdminLTEJqueryUiAsset.php</file>
    <file>AdminLTEJqueryUiMinifyAsset.php</file>
    <file>AdminLTEDateTimeAsset.php</file>
    <file>AdminLTEDateTimeMinifyAsset.php</file>
    <file>AdminLTEIcheckAsset.php</file>
    <file>AdminLTEIcheckMinifyAsset.php</file>
    <file>assets</file>
    <file>widgets</file>

    <exclude-pattern>*/widgets/Timeline.php</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="warning-severity" value="0"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!--
        Narrow transitional exceptions for pre-existing multi-line control formatting.
        The files remain in the PHPCS scan; only this specific formatting sniff is
        deferred so new PSR-12 violations elsewhere still fail CI.
    -->
    <rule ref="PSR12.ControlStructures.ControlStructureSpacing">
        <exclude-pattern>*/widgets/Invoice.php</exclude-pattern>
        <exclude-pattern>*/widgets/SidebarMenu.php</exclude-pattern>
    </rule>
</ruleset>
