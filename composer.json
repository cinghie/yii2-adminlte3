{
    "name": "cinghie/yii2-adminlte3",
    "description": "Asset Bundle to include AdminLTE 3 on your Yii 2 project",
    "keywords": [
        "yii2",
        "yii2 template",
        "yii2 AdminLTE",
        "AdminLTE 3",
        "adminlte 3",
        "admin lte 3"
    ],
    "homepage": "https://github.com/cinghie/yii2-adminlte3",
    "type": "yii2-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Gogodigital.it",
            "email": "info@gogodigital.it",
            "homepage": "http://www.gogodigital.it/"
        }
    ],
    "require": {
        "php": ">=7.4",
        "almasaeed2010/adminlte": "^3.0.0",
        "cinghie/yii2-fontawesome": "^1.4.4",
        "cinghie/yii2-ionicons": "^1.1.0",
        "kartik-v/yii2-bootstrap4-dropdown": "^1.0.4",
        "kartik-v/yii2-detail-view": "^1.8.7",
        "kartik-v/yii2-grid": "^3.5.3",
        "yiisoft/yii2": "^2.0.54",
        "yiisoft/yii2-bootstrap4": "^2.0.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "cinghie\\adminlte3\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "cinghie\\adminlte3\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml --fail-on-warning"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    },
    "prefer-stable": true
}
